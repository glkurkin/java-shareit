# ----------------------------
# Maven / Gradle build outputs
# ----------------------------

# Maven
**/target/
!**/src/**/target/!*/  # (оставим только папку target из исходников, если нужна)
# Gradle
**/build/
!**/src/**/build/!*/

# ----------------------------
# Java binaries and packages
# ----------------------------
*.class
*.jar
*.war
*.ear

